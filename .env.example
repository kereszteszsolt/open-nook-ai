# OpenNook AI - ONK-001 local foundation. Chat is not implemented yet.
# Copy to .env and replace the password in both settings below.
APP_PORT=3000

# Local-only development credentials; never reuse in a public deployment.
POSTGRES_DB=open_nook
POSTGRES_USER=open_nook
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://open_nook:replace-with-local-password@db:5432/open_nook?schema=public

# Optional localhost DB port with compose.dev.yaml; native Next.js uses
# DATABASE_URL=postgresql://open_nook:<your-password>@127.0.0.1:5433/open_nook?schema=public
DB_PORT=5433

# Reserved for ONK-002; no OpenRouter requests are made by this foundation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_1=
OPENROUTER_MODEL_2=
OPENROUTER_MODEL_3=
OPENROUTER_MODEL_4=
OPENROUTER_MODEL_5=

# Bounded requests; exact mappings are introduced in ONK-002.
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048
