# OpenNook AI - local chat with server-only OpenRouter; history is stored in PostgreSQL.
# Copy to .env and replace the password in both settings below.
APP_PORT=3000

# Local-only development credentials; never reuse in a public deployment.
POSTGRES_DB=open_nook
POSTGRES_USER=open_nook
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://open_nook:replace-with-local-password@db:5432/open_nook?schema=public

# Optional localhost DB port with compose.dev.yaml; native Next.js uses
# DATABASE_URL=postgresql://open_nook:<your-password>@127.0.0.1:5433/open_nook?schema=public
DB_PORT=5433

# Server-only. Blank key or no models disables chat; no calls on page load.
# Set only qualified model IDs you intend to use; explicit API calls may cost money.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_1=
OPENROUTER_MODEL_2=
OPENROUTER_MODEL_3=
OPENROUTER_MODEL_4=
OPENROUTER_MODEL_5=

# Total request deadline: 1000..120000 ms, including upload and streaming.
AI_REQUEST_TIMEOUT_MS=60000
# Provider max_tokens: 1..8192. No automatic retries or model fallback.
AI_MAX_OUTPUT_TOKENS=2048

# Optional server-only MCP discovery. Blank URL disables the integration; enabling is always manual.
# The only approved endpoint is https://mcp.context7.com/mcp (Streamable HTTP).
MCP_CONTEXT7_URL=
# Optional Context7 bearer key. Never place it in NEXT_PUBLIC_* or browser settings.
MCP_CONTEXT7_API_KEY=
# Only this read-only subset is permitted; unknown names invalidate the configuration.
MCP_CONTEXT7_ALLOWED_TOOLS=resolve-library-id,query-docs
