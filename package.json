{
  "name": "open-nook-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "predev": "node scripts/prepare-app-assets.mjs && node --env-file-if-exists=.env scripts/validate-env.ts && prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-app-assets.mjs",
    "build": "prisma generate && next build",
    "prestart": "node --env-file-if-exists=.env scripts/validate-env.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:browser": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.147",
    "@assistant-ui/ai-sdk": "0.0.13",
    "@assistant-ui/react": "0.15.29",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-select": "2.4.1",
    "ai": "7.0.143",
    "dompurify": "3.4.17",
    "dotenv": "18.0.8",
    "katex": "0.19.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
